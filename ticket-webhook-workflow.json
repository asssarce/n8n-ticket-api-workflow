        "jsCode": "const data = $json.body;\n\nconst requiredFields = [\n  \"ticket_id\",\n  \"email\",\n  \"subject\",\n  \"message\",\n  \"customer_tier\",\n  \"created_at\"\n];\n\nfor (const field of requiredFields){\n  if (!data[field]) {\n    return {\n      json: {\n        success: false,\n        error: `Missing required field: ${field}`\n      }\n    };\n  }\n}\n\nreturn {\n  json: {\n    success: true,\n    data\n  }\n};"
      },
